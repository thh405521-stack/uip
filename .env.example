APP_NAME="Data Analysis Portal API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default — no separate DB server needed. `php artisan migrate`
# creates database/database.sqlite automatically. To use MySQL/Postgres
# instead, uncomment and fill in the block below, and see the README note
# about DataAnalysisDashboardService::userGrowthSeries()'s strftime() call.
# MySQL via XAMPP — database name: uip-nub (create it in phpMyAdmin first,
# XAMPP's default MySQL user is root with no password).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uip-nub
DB_USERNAME=root
DB_PASSWORD=

# This app doesn't use Laravel's built-in session/queue/cache for
# anything (auth is stateless JWT bearer tokens — see UipJwtService) —
# file/sync drivers keep local setup to zero extra tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Data Analysis Portal specific ---------------------------------------

# Set to a long random string before deploying anywhere real. Generate one
# with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=local-development-secret-change-me-before-deploying
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# The React frontend's dev-server origin — controls CORS (see
# UipCorsMiddleware). Update to your deployed frontend's URL in production.
FRONTEND_URL=http://localhost:5173
